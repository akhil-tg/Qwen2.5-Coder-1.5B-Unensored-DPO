# Copy this file to .env if you want to set an optional Hugging Face token.
# NOTE: the model in this repo (mradermacher/Qwen2.5-Coder-1.5B-Unsensored-DPO-i1-GGUF)
# is PUBLIC, so a token is NOT required. This file only exists in case you
# later switch to a gated/private model.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx